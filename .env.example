# ==============================================================================
# Model & Inference Configuration
# ==============================================================================

# Whisper model variant to load.
# Options:
#   - Standard models: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v1, large-v2, large-v3
#   - Optimized models: large-v3-turbo, distil-large-v2, distil-large-v3
WHISPER_MODEL=large-v3-turbo

# Target hardware processing unit.
# Options:
#   - cpu  (Default for standard processors)
#   - cuda (Requires NVIDIA GPU with CUDA drivers configured in Docker)
#   - auto (Automatically selects CUDA if available, otherwise falls back to CPU)
DEVICE=cpu

# Quantization and numerical precision type.
# Options for CPU:
#   - int8         (Recommended for CPU: lowest memory, highest speed)
#   - int8_float16 (Hybrid precision)
#   - int16        (Higher precision)
#   - float32      (Full precision, slowest on CPU)
# Options for CUDA (GPU):
#   - float16, int8_float16, bfloat16, float32
COMPUTE_TYPE=int8

# Target spoken language in the source audio.
# Options:
#   - auto (Automatically detects language per file)
#   - ISO 639-1 code: en (English), fr (French), es (Spanish), de (German), it (Italian), etc.
LANGUAGE=en

# Decoding beam search width.
# Options:
#   - 1      (Greedy search: fastest performance, slightly lower accuracy)
#   - 2 to 5 (Standard search: balanced performance and accuracy)
#   - 6 to 10 (Deep search: highest accuracy, slower processing)
BEAM_SIZE=5

# Voice Activity Detection (VAD) filter to strip silences before transcription.
# Prevents model hallucinations during long periods of silent audio.
# Options:
#   - True  (Enabled: filters dead air dynamically)
#   - False (Disabled: processes entire audio stream continuously)
VAD_FILTER=True


# ==============================================================================
# Environment & Dependency Configuration
# ==============================================================================

# Docker base image used to execute the Python runtime.
# Options:
#   - python:3.11-slim (Recommended: lightweight, fast build)
#   - python:3.10-slim
#   - python:3.12-slim
PYTHON_IMAGE=python:3.11-slim

# Package specifier for the faster-whisper Python library.
# Options:
#   - faster-whisper         (Installs latest available package)
#   - faster-whisper==1.1.0  (Pins to a specific version for reproducible builds)
FASTER_WHISPER_VERSION=faster-whisper


# ==============================================================================
# File System & Mount Paths
# ==============================================================================

# Local directory where input audio files (.ogg, .m4a, .wav, .mp3) are placed.
# Options: Relative path (./audio) or absolute path (/home/user/media/audio)
AUDIO_DIR=./audio

# Local directory where generated transcript files (.txt) will be saved.
# Options: Relative path (./output) or absolute path (/home/user/media/transcripts)
OUTPUT_DIR=./output

# Local directory used to cache Hugging Face model weights across runs.
# Options: Relative path (./model-cache) or absolute path (/home/user/.cache/huggingface)
CACHE_DIR=./model-cache
